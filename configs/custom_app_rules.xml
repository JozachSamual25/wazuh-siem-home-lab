<!-- Copy to: /var/ossec/etc/rules/local_rules.xml (Wazuh server) -->
<group name="custom_app,authentication_failed,">

  <!-- Fires on every failed login from the custom application -->
  <rule id="100100" level="5">
    <decoded_as>custom_app</decoded_as>
    <description>custom_app: failed login</description>
  </rule>

  <!-- Fires when the same source IP fails repeatedly inside 60 seconds -->
  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_srcip />
    <description>custom_app: repeated failed logins from one source</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
